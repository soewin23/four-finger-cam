{
  "name": "four-finger-cam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Four-finger interactive filter camera — real-time hand-tracked quadrilateral filter masking in WebGL2.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:geometry": "node --experimental-strip-types --no-warnings scripts/verify-geometry.ts",
    "test:render": "npm run build && node scripts/verify-render.mjs",
    "preview:ui": "npm run build && node scripts/preview-ui.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
